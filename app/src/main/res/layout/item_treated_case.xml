<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/tvCaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-10-27"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCaseDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وصف الحالة هنا..."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCaseProcedures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الإجراءات المتخذة..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCasePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 صورة مرفقة"
            android:textColor="@color/green_success"
            android:textSize="12sp"
            android:visibility="gone" />
        <!-- سيظهر فقط إذا كان هناك مسار صورة -->
    </LinearLayout>
</androidx.cardview.widget.CardView>