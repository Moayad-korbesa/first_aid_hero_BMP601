<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- 1. الشريط العلوي (خارج الـ ScrollView) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="خطوات الإسعاف"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- 2. الـ ScrollView (يجب أن يحتوي على طفل واحد فقط) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- هذا هو الطفل الوحيد المسموح به داخل الـ ScrollView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- عنوان الحالة -->
            <TextView
                android:id="@+id/tvCaseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عنوان الحالة"
                android:textColor="@color/primary_dark"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- مستوى الخطورة -->
            <TextView
                android:id="@+id/tvDangerLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حرجة"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp" />

            <!-- قسم الأعراض -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الأعراض المصاحبة:"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الأعراض هنا..."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:background="@drawable/search_background"
                android:padding="12dp"
                android:layout_marginBottom="20dp" />

            <!-- عنوان خطوات الإسعاف -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خطوات الإسعاف:"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- قائمة الخطوات -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layout_marginBottom="16dp" />

            <!-- زر الاتصال بالطوارئ (مخفي افتراضياً، يظهر برمجياً للحالات الحرجة والمتوسطة) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergencyCall"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="اتصل بالطوارئ (110)"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/red_emergency"
                app:cornerRadius="26dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>